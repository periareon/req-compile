load("@pip_deps//:defs.bzl", "requirement", "requirement_wheel", "requirements")
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_req_compile//:defs.bzl", "py_package_annotation_consumer", "py_reqs_compiler", "py_reqs_solution_test")
load("@rules_venv//python:defs.bzl", "py_test")

py_reqs_compiler(
    name = "requirements.update",
    requirements_in = "requirements.in",
    requirements_txts = {
        "requirements.linux.txt": "manylinux_2_28_x86_64",
        "requirements.macos.txt": "macosx_11_0_arm64",
        "requirements.windows.txt": "win_amd64",
    },
)

py_reqs_solution_test(
    name = "requirements_test",
    compiler = ":requirements.update",
)

py_test(
    name = "annotations",
    srcs = ["annotations.py"],
    data = [requirement_wheel("numpy")],
    env = {
        # Used to locate the repository the numpy wheel was extracted into.
        "NUMPY_WHEEL": "$(rlocationpath {})".format(requirement_wheel("numpy")),
    },
    deps = [
        "@rules_venv//python/runfiles",
    ] + requirements([
        "numpy",
        "sphinx",
    ]),
)

py_package_annotation_consumer(
    name = "numpy_headers",
    # Look for the `py_package_annotation_target` named `headers`.
    consume = "headers",
    package = requirement("numpy"),
)

cc_test(
    name = "numpy_consumer_test",
    srcs = ["numpy_consumer_test.cc"],
    deps = [":numpy_headers"],
)
