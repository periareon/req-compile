load("@rules_python//python:defs.bzl", "py_library")
load("@rules_req_compile//:defs.bzl", "py_reqs_compiler", "py_reqs_solution_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "lib",
    srcs = ["shared_hubs_lib.py"],
    deps = [
        "@shared_hubs_lib_deps//click",
        "@shared_hubs_lib_deps//requests",
    ],
)

# `requests` as resolved by this module, which did not ask for any extras.
py_library(
    name = "requests",
    deps = ["@shared_hubs_lib_deps//requests"],
)

LOCKS = {
    "linux_x86_64": "manylinux_2_28_x86_64",
    "macos_aarch64": "macosx_11_0_arm64",
    "windows_x86_64": "win_amd64",
}

[
    py_reqs_compiler(
        name = "requirements.{}.update".format(id),
        platform = platform,
        requirements_in = "requirements.in",
        requirements_txt = "requirements.{}.txt".format(id),
    )
    for id, platform in LOCKS.items()
]

[
    py_reqs_solution_test(
        name = "requirements.{}.test".format(id),
        compiler = ":requirements.{}.update".format(id),
    )
    for id in LOCKS
]
