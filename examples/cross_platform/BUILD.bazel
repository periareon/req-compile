load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load("@rules_req_compile//:defs.bzl", "py_reqs_compiler", "py_reqs_solution_test")
load("@rules_venv//python:defs.bzl", "py_binary", "py_test")
load("@rules_venv//python/venv:defs.bzl", "py_venv_zipapp")
load(":cross_platform_test_utils.bzl", "fake_cc_config", "platform_transitioned_file")

py_reqs_compiler(
    name = "requirements.update",
    requirements_in = "requirements.in",
    requirements_txts = {
        "requirements.linux.txt": "manylinux_2_28_x86_64",
        "requirements.macos.txt": "macosx_11_0_arm64",
        "requirements.windows.txt": "win_amd64",
    },
)

py_reqs_solution_test(
    name = "requirements_test",
    compiler = ":requirements.update",
)

fake_cc_config(
    name = "fake_cc_config",
)

filegroup(
    name = "empty",
)

cc_toolchain(
    name = "fake_cc_toolchain_cc_impl",
    all_files = ":empty",
    compiler_files = ":empty",
    dwp_files = ":empty",
    linker_files = ":empty",
    objcopy_files = ":empty",
    strip_files = ":empty",
    supports_param_files = 0,
    toolchain_config = ":fake_cc_config",
    toolchain_identifier = "req_compile_cross_platform_fake_cc_toolchain",
)

# For some reason python requires a `cc_toolchain` but for pure python
# binaries it's not used. To account for this in these tests, we make
# a fake toolchain so we can easily build cross-platform. The python
# toolchains are already configured to do the right thing.
toolchain(
    name = "fake_cc_toolchain",
    toolchain = ":fake_cc_toolchain_cc_impl",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

platform(
    name = "linux",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "macos",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "windows",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

py_binary(
    name = "cross_platform",
    srcs = ["cross_platform.py"],
    deps = [
        "@pip_deps//black",
    ],
)

py_venv_zipapp(
    name = "cross_platform_pyz",
    binary = ":cross_platform",
)

platform_transitioned_file(
    name = "cross_platform_linux",
    extra_toolchains = [":fake_cc_toolchain"],
    platform = ":linux",
    target = ":cross_platform_pyz",
)

platform_transitioned_file(
    name = "cross_platform_macos",
    extra_toolchains = [":fake_cc_toolchain"],
    platform = ":macos",
    target = ":cross_platform_pyz",
)

platform_transitioned_file(
    name = "cross_platform_windows",
    extra_toolchains = [":fake_cc_toolchain"],
    platform = ":windows",
    target = ":cross_platform_pyz",
)

py_test(
    name = "cross_platform_test",
    srcs = ["cross_platform_test.py"],
    data = [
        "requirements.linux.txt",
        "requirements.macos.txt",
        "requirements.windows.txt",
        ":cross_platform_linux",
        ":cross_platform_macos",
        ":cross_platform_windows",
    ],
    env = {
        "PYTHON_ZIP_FILE_LINUX": "$(rlocationpath :cross_platform_linux)",
        "PYTHON_ZIP_FILE_MACOS": "$(rlocationpath :cross_platform_macos)",
        "PYTHON_ZIP_FILE_WINDOWS": "$(rlocationpath :cross_platform_windows)",
        "REQUIREMENTS_LINUX": "$(rlocationpath requirements.linux.txt)",
        "REQUIREMENTS_MACOS": "$(rlocationpath requirements.macos.txt)",
        "REQUIREMENTS_WINDOWS": "$(rlocationpath requirements.windows.txt)",
    },
    deps = ["@rules_venv//python/runfiles"],
)
