load("@rules_venv//python:defs.bzl", "py_library")
load("@rules_venv//python/wasm:defs.bzl", "py_wasm_module")

# Stand-ins for the packages `req_compile` imports but that cannot work inside
# the module: `requests` (nothing downloads), `toml` and `setuptools` (no
# `pyproject.toml` or `setup.py` is ever evaluated), `multiprocessing` (one
# thread) and `ctypes` (no dynamic loading, so the host is "not glibc"). The
# import root makes them importable under those names; only the module
# depends on them, so nothing else sees the real packages shadowed.
py_library(
    name = "shims",
    srcs = glob(["shims/**/*.py"]),
    imports = ["shims"],
)

# `req_compile_solver.wasm`: CPython 3.14, the solver and the parts of the
# standard library it needs, as one WebAssembly module that imports nothing,
# built by rules_venv's `py_wasm_module` with the toolchain rules_venv
# registers for that Python, whose CPython is the trampoline build of
# periareon/cpython-wasi-build (see README.md, "Where the time goes"); Bazel's
# runtime compiles all of it. The `requirements` extension runs it with
# `module_ctx.execute_wasm`; `req_compile/wasm/exports.py` is the entry point
# and README.md describes the calling convention. A release builds it,
# attaches it and bakes its hash into `req_compile/private/solver.bzl`.
# Building it fetches the toolchain (a CPython for wasm32-wasi, a wasi-sdk and
# Wizer, about 160 MB) the first time and then takes seconds. rules_venv has
# that toolchain for Linux and macOS on x86_64 and arm64 and none for Windows,
# so the target is incompatible there and `//...` skips it rather than failing
# toolchain resolution.
py_wasm_module(
    name = "req_compile_solver",
    entry = "req_compile.wasm.exports",
    python_version = "3.14",
    visibility = ["//visibility:public"],
    exports = ["solve"],
    deps = [
        ":shims",
        "//req_compile:wasm_solver",
    ],
)
