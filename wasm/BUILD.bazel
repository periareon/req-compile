load("@rules_venv//python:defs.bzl", "py_library")
load("@rules_venv//python/wasm:defs.bzl", "py_wasm_module")

# Stand-ins for the packages `req_compile` imports but that cannot work inside
# the module: `requests` (nothing downloads), `toml` and `setuptools` (no
# `pyproject.toml` or `setup.py` is ever evaluated), `multiprocessing` (one
# thread) and `ctypes` (no dynamic loading, so the host is "not glibc"). The
# import root makes them importable under those names, which is also why
# pylint and mypy are kept off them: both load the modules they shadow.
py_library(
    name = "shims",
    srcs = glob(["shims/**/*.py"]),
    imports = ["shims"],
    tags = [
        "no_mypy",
        "no_pylint",
    ],
)

# `req_compile_solver.wasm`: CPython 3.14, the solver and the parts of the
# standard library it needs, as one WebAssembly module that imports nothing,
# built by rules_venv's `py_wasm_module` with the `py_wasm_toolchain` of
# `//wasm/toolchain`: the trampoline CPython of periareon/cpython-wasi-build,
# which Bazel's runtime compiles whole (see README.md, "Where the time goes"),
# with rules_venv's wasi-sdk and Wizer. The `requirements` extension runs it with
# `module_ctx.execute_wasm`; `req_compile/wasm/exports.py` is the entry point
# and README.md describes the calling convention. A release builds it,
# attaches it and bakes its hash into `req_compile/private/solver.bzl`. The
# target is `manual`: building it fetches a CPython for wasm32-wasi, a
# wasi-sdk and Wizer, and the toolchain exists for Linux and macOS hosts.
py_wasm_module(
    name = "req_compile_solver",
    entry = "req_compile.wasm.exports",
    python_version = "3.14",
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    exports = ["solve"],
    deps = [
        ":shims",
        "//req_compile:wasm_solver",
    ],
)
