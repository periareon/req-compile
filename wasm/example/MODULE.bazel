"""An example of resolving requirements inside Bazel with the WebAssembly solver.

This example depends on the source checkout of `rules_req_compile`, which has no
solver module of its own (a release does, and downloads it). Build one with
`../build_solver.sh`, copy it next to this file, and name it with `solver`:

    bazel build //...

The hub is resolved by the `requirements` module extension of `rules_req_compile`
in rounds of downloads, and the result is recorded in `MODULE.bazel.lock`.
`requirements.txt` is the pin list the hub keeps in step with its solution:

    bazel run @pip_deps//:requirements.update

writes it, and `bazel test //:requirements.test` fails while it is out of date.
"""

module(name = "req_compile_wasm_example")

bazel_dep(name = "rules_venv", version = "0.34.0")
bazel_dep(name = "rules_req_compile", version = "0.0.0")
local_path_override(
    module_name = "rules_req_compile",
    path = "../..",
)

requirements = use_extension("@rules_req_compile//extensions:python.bzl", "requirements")
requirements.parse(
    name = "pip_deps",
    platforms = [
        "manylinux_2_28_x86_64",
        "macosx_11_0_arm64",
    ],
    python_version = "3.11",
    requirements_in = ["//:requirements.in"],
    # The pinned file: what `requirements.in` resolved to, with hashes. Every
    # package it lists is pinned to that version and those hashes, so a version
    # bumped in it (Dependabot's pip updater does this) is what the hub resolves
    # to next; a package new to `requirements.in` resolves freely and is then
    # added to it by `requirements.update`.
    requirements_txt = "//:requirements.txt",
    solver = "//:req_compile_solver.wasm",
)
use_repo(requirements, "pip_deps")
