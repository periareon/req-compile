load("@pip_deps//:defs.bzl", "requirement")
load("@rules_venv//python:defs.bzl", "py_library")

exports_files([
    "req_compile_solver.wasm",
    "requirements.in",
    "requirements.txt",
])

py_library(
    name = "uses_requests",
    deps = [requirement("requests")],
)

filegroup(
    name = "wheels",
    srcs = ["@pip_deps//all_wheels"],
)

# Fails while requirements.txt no longer matches what the hub resolved from
# requirements.in; `bazel run @pip_deps//:requirements.update` rewrites it.
test_suite(
    name = "requirements.test",
    tests = ["@pip_deps//:requirements.test"],
)
