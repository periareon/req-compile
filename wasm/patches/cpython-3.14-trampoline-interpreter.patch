diff --git a/Python/ceval.c b/Python/ceval.c
index eca281e..c872bd6 100644
--- a/Python/ceval.c
+++ b/Python/ceval.c
@@ -1125,6 +1125,39 @@ _PyObjectArray_Free(PyObject **array, PyObject **scratch)
 #if Py_TAIL_CALL_INTERP
 #include "opcode_targets.h"
 #include "generated_cases.c.h"
+
+/* Run handlers until one returns something other than the state pointer,
+ * which is the result of the frame. */
+static inline PyObject *
+_Py_run_trampoline(py_tail_call_funcptr first, _PyInterpreterFrame *frame,
+                   _PyStackRef *stack_pointer, PyThreadState *tstate,
+                   _Py_CODEUNIT *next_instr, int oparg
+#ifdef Py_STATS
+                   , int lastopcode
+#endif
+                   )
+{
+    _PyTrampolineState st;
+    st.next = first;
+    st.frame = frame;
+    st.stack_pointer = stack_pointer;
+    st.tstate = tstate;
+    st.next_instr = next_instr;
+    st.oparg = oparg;
+#ifdef Py_STATS
+    st.lastopcode = lastopcode;
+#endif
+    for (;;) {
+#ifdef Py_STATS
+        PyObject *result = st.next(&st, st.frame, st.stack_pointer, st.tstate, st.next_instr, st.oparg, st.lastopcode);
+#else
+        PyObject *result = st.next(&st, st.frame, st.stack_pointer, st.tstate, st.next_instr, st.oparg);
+#endif
+        if (result != (PyObject *)&st) {
+            return result;
+        }
+    }
+}
 #endif
 
 #if (defined(__GNUC__) && __GNUC__ >= 10 && !defined(__clang__)) && defined(__x86_64__)
@@ -1235,9 +1268,9 @@ _PyEval_EvalFrameDefault(PyThreadState *tstate, _PyInterpreterFrame *frame, int
         stack_pointer = _PyFrame_GetStackPointer(frame);
