"""rules_req_compile"""

module(
    name = "rules_req_compile",
    version = "1.6.5-rc2",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.9")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_venv", version = "0.35.0")

bazel_dep(name = "buildozer", version = "8.2.1", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.2.1.2", dev_dependency = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)

# The one Python this repository builds and tests with. It is also the CPython
# of `//wasm:req_compile_solver`: `py_wasm_module` embeds the CPython of its
# `python_version` and builds with the Python toolchain of that version.
# req-compile itself is tested on every version it supports by CI's pytest
# matrix, outside Bazel.
python.toolchain(
    configure_coverage_tool = True,
    # Working around a rules_python issue with docker
    # https://github.com/bazelbuild/rules_python/pull/713
    ignore_root_user_error = True,
    is_default = True,
    python_version = "3.14",
)

# The CPython inside `//wasm:req_compile_solver`. rules_venv's own toolchain
# embeds the stock build of cpython-wasi-build, whose evaluation loop is larger
# than a JVM method may be, so Bazel's runtime interprets it and a solve takes
# tens of seconds; the trampoline build from periareon/cpython-wasi-build keeps
# every function small and a solve takes a couple of seconds (wasm/README.md).
# `//wasm/toolchain` assembles a `py_wasm_toolchain` from it and rules_venv's
# own wasi-sdk and Wizer, registered below ahead of rules_venv's. All of it is
# a dev dependency: only this repository builds the module (a release attaches
# it), and the directives stay valid for consumers on Bazel 7.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "cpython_wasi_trampoline_3_14",
    build_file_content = """\
package(default_visibility = ["//visibility:public"])

exports_files(["pyconfig.h"])

filegroup(
    name = "libs",
    srcs = ["libpython3.14.a"] + glob(["Modules/**/*.a"]),
)
""",
    dev_dependency = True,
    sha256 = "89e2c252df9919a3d5ec483278c8f2d8e42c9ad79cfcf190a32052b9078cb3f8",
    url = "https://github.com/periareon/cpython-wasi-build/releases/download/v3.14.9/_build-python-3.14.9-wasi_sdk-24-trampoline.zip",
)

http_archive(
    name = "cpython_wasi_trampoline_3_14_stdlib",
    build_file_content = """\
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "stdlib",
    srcs = glob(["lib/python3.14/**/*.py"]),
)
""",
    dev_dependency = True,
    sha256 = "d31f7a5abe9f8939180fcd55aa497826e153f48b7f472758daf03591a215687e",
    url = "https://github.com/periareon/cpython-wasi-build/releases/download/v3.14.9/python-3.14.9-wasi_sdk-24-trampoline.zip",
)

py_wasm = use_extension("@rules_venv//python/wasm:extensions.bzl", "py_wasm", dev_dependency = True)
use_repo(
    py_wasm,
    "rules_venv_py_wasm_wasi_sdk_24_linux_aarch64",
    "rules_venv_py_wasm_wasi_sdk_24_linux_x86_64",
    "rules_venv_py_wasm_wasi_sdk_24_macos_aarch64",
    "rules_venv_py_wasm_wasi_sdk_24_macos_x86_64",
    "rules_venv_py_wasm_wizer_linux_aarch64",
    "rules_venv_py_wasm_wizer_linux_x86_64",
    "rules_venv_py_wasm_wizer_macos_aarch64",
    "rules_venv_py_wasm_wizer_macos_x86_64",
)

register_toolchains(
    "//wasm/toolchain:all",
    dev_dependency = True,
)

requirements = use_extension("//extensions:python.bzl", "requirements")
requirements.parse(
    name = "req_compile_deps",
    config_settings = {
        # Any 32 or 64 bit arm Linux platform uses the aarch64 lock.
        "//tools/constraints:linux_aarch_any": "linux_aarch64",
        "//tools/constraints:linux_x86_64": "linux_x86_64",
        "//tools/constraints:macos_aarch64": "macos_aarch64",
        "//tools/constraints:macos_x86_64": "macos_x86_64",
        "//tools/constraints:windows_x86_64": "windows_x86_64",
    },
    requirements_locks = {
        "//3rdparty:requirements.linux_aarch64.txt": "linux_aarch64",
        "//3rdparty:requirements.linux_x86_64.txt": "linux_x86_64",
        "//3rdparty:requirements.macos_aarch64.txt": "macos_aarch64",
        "//3rdparty:requirements.macos_x86_64.txt": "macos_x86_64",
        "//3rdparty:requirements.windows_x86_64.txt": "windows_x86_64",
    },
)
use_repo(requirements, "req_compile_deps")

sdist_deps = use_extension("//req_compile/private:sdist.bzl", "sdist_deps")
use_repo(
    sdist_deps,
    "req_compile_sdist_compiler__pip",
    "req_compile_sdist_compiler__setuptools",
    "req_compile_sdist_compiler__wheel",
)

# Toolchains backing the `rules_venv` lint, type check, test and wheel rules.
# These are only ever used when building this repository itself.
register_toolchains(
    "//tools/toolchains:py_black_toolchain",
    "//tools/toolchains:py_isort_toolchain",
    "//tools/toolchains:py_mypy_toolchain",
    "//tools/toolchains:py_pylint_toolchain",
    "//tools/toolchains:py_pytest_toolchain",
    "//tools/toolchains:py_wheel_toolchain",
    dev_dependency = True,
)

bazel_dep(name = "rules_go", version = "0.59.0", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.download(version = "1.23.1")

bazel_dep(name = "gazelle", version = "0.47.0", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.8.1", dev_dependency = True)
