load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("//:version.bzl", "VERSION")

exports_files([
    "CHANGELOG.rst",
    "LICENSE.txt",
    "MODULE.bazel",
    "README.rst",
    "pyproject.toml",
    "requirements.in",
    "setup.py",
    "test-requirements.in",
    "version.bzl",
    "defs.bzl",
])

# What this module is and what it is licensed under, for the tooling that
# collects the metadata of the packages a binary is built from, such as an
# SBOM generator. `REPO.bazel` attaches it to every target of the repository.
package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel("rules_req_compile", VERSION),
    visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "LICENSE.txt",
    visibility = ["//visibility:public"],
)

alias(
    name = "buildifier",
    actual = "//tools:buildifier",
)

alias(
    name = "buildifier.check",
    actual = "//tools:buildifier.check",
)

alias(
    name = "gazelle",
    actual = "//tools:gazelle",
    tags = ["manual"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//req_compile/private:annotation",
        "//req_compile/private:reqs_repo",
        "//req_compile/private:whl_repo",
    ],
)

bzl_library(
    name = "version",
    srcs = ["version.bzl"],
    visibility = ["//visibility:public"],
)
