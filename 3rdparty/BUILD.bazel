load("//:defs.bzl", "py_reqs_compiler", "py_reqs_solution_test")

filegroup(
    name = "requirements",
    srcs = ["bazel-requirements.in"],
    data = [
        "//:requirements.in",
        "//:test-requirements.in",
    ],
)

# The solutions of every platform are compiled together and share versions.
py_reqs_compiler(
    name = "requirements.update",
    requirements_in = ":requirements",
    requirements_txts = {
        "requirements.linux_aarch64.txt": "manylinux_2_28_aarch64",
        "requirements.linux_x86_64.txt": "manylinux_2_28_x86_64",
        "requirements.macos_aarch64.txt": "macosx_11_0_arm64",
        "requirements.macos_x86_64.txt": "macosx_11_0_x86_64",
        "requirements.windows_x86_64.txt": "win_amd64",
    },
)

py_reqs_solution_test(
    name = "requirements_test",
    compiler = ":requirements.update",
)
